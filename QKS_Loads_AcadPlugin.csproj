<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AcadVersion Condition="'$(AcadVersion)' == ''">2024</AcadVersion>
    <TargetFramework Condition="'$(AcadVersion)' == '2018'">net46</TargetFramework>
    <TargetFramework Condition="'$(AcadVersion)' == '2019' Or '$(AcadVersion)' == '2020'">net47</TargetFramework>
    <TargetFramework Condition="'$(AcadVersion)' == '2021' Or '$(AcadVersion)' == '2022' Or '$(AcadVersion)' == '2023' Or '$(AcadVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(AcadVersion)' == '2025' Or '$(AcadVersion)' == '2026'">net8.0-windows</TargetFramework>
    <UseWPF Condition="'$(AcadVersion)' == '2025' Or '$(AcadVersion)' == '2026'">true</UseWPF>
    <UseWindowsForms Condition="'$(AcadVersion)' == '2025' Or '$(AcadVersion)' == '2026'">true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AcadSdkDir Condition="'$(AcadSdkDir)' == ''">C:\Program Files\Autodesk\AutoCAD $(AcadVersion)</AcadSdkDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>QKS_Loads_AcadPlugin</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RootNamespace>QKS_Loads_AcadPlugin</RootNamespace>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="accoremgd"><HintPath>$(AcadSdkDir)/accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadSdkDir)/acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadSdkDir)/acmgd.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="QksLoadsCommands.cs;Plugin/**/*.cs;Shared/**/*.cs" />
  </ItemGroup>
  <Target Name="CheckAcadSdk" BeforeTargets="ResolveReferences">
    <Error Condition="'$(AcadVersion)' != '2018' And '$(AcadVersion)' != '2019' And '$(AcadVersion)' != '2020' And '$(AcadVersion)' != '2021' And '$(AcadVersion)' != '2022' And '$(AcadVersion)' != '2023' And '$(AcadVersion)' != '2024' And '$(AcadVersion)' != '2025' And '$(AcadVersion)' != '2026'" Text="Supported build targets: AutoCAD 2018-2026, Windows x64 only." />
    <Error Condition="!Exists('$(AcadSdkDir)/acmgd.dll') Or !Exists('$(AcadSdkDir)/acdbmgd.dll') Or !Exists('$(AcadSdkDir)/accoremgd.dll')" Text="Missing AutoCAD SDK. Set -p:AcadSdkDir to the matching year's managed SDK folder." />
  </Target>
</Project>
