<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EtabsApiPath Condition="'$(EtabsApiPath)' == ''">C:\Program Files\Computers and Structures\ETABS 22\CSiAPIv1.dll</EtabsApiPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.77" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="CSiAPIv1">
      <HintPath>$(EtabsApiPath)</HintPath>
      <Private>true</Private>
      <CopyLocal>true</CopyLocal>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png;Resources\*.ico" />
    <EmbeddedResource Include="Resources\*.png;Resources\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AddInMain.cs;Ribbon/**/*.cs;Services/**/*.cs;Views/**/*.cs;Shared/**/*.cs;Modeling/**/*.cs;ViewModels/**/*.cs" />
  </ItemGroup>
  <Target Name="CheckEtabsApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(EtabsApiPath)')" Text="Missing ETABS API. Set -p:EtabsApiPath=path/to/CSiAPIv1.dll." />
  </Target>
</Project>
