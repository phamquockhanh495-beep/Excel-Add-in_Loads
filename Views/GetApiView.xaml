<Window x:Class="QksExcelAddIn.Views.GetApiView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Kết Nối Hệ Thống API"
        Height="275" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontSize="12"
        FontFamily="Segoe UI"
        Topmost="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/MaterialDesignResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom GroupBox Style with Solid Navy Border and Underlined Header -->
            <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="BorderBrush" Value="#0F2240"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- GroupBox Header (Underlined with Navy brush) -->
                                    <Border Grid.Row="0" Background="Transparent" Padding="8,5,8,5" BorderBrush="#0F2240" BorderThickness="0,0,0,0.5">
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                    </Border>

                                    <!-- GroupBox Content -->
                                    <Border Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="#0F2240"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ComboBox Style using Material Design standard -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#0F2240" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Headbar -->
            <Grid Grid.Row="0" Background="#0F2240" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                    <Image Source="pack://application:,,,/QksExcelAddIn;component/Resources/excel.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QKS" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Margin="3,0,3,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="KẾT NỐI HỆ THỐNG API - QKS LOADS" Foreground="White" 
                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="2,0,0,0"/>

                <!-- Minimize Button -->
                <Button Grid.Column="2" Content="—" Foreground="White" Background="Transparent" 
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                        Click="MinimizeButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                             <Trigger Property="IsMouseOver" Value="True">
                                                 <Setter TargetName="border" Property="Background" Value="#10B981"/>
                                             </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="3" Content="✕" Foreground="White" Background="Transparent" 
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                        Click="CloseButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                             <Trigger Property="IsMouseOver" Value="True">
                                                 <Setter TargetName="border" Property="Background" Value="#DC3232"/>
                                             </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="8,6,8,2">
                <GroupBox Header="CHỌN FILE CẦN SỬ DỤNG " Style="{StaticResource CustomGroupBoxStyle}">
                    <Grid Margin="6,10,6,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Excel -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bảng tính Excel :" VerticalAlignment="Center" 
                                   FontFamily="Segoe UI" Foreground="#0F2240" FontWeight="Bold" Margin="4,0,0,0"/>
                        <ComboBox x:Name="CB_Excel" Grid.Row="0" Grid.Column="1" Margin="4,0,4,0" 
                                  SelectionChanged="CB_Excel_SelectionChanged"/>
                        <ToggleButton x:Name="Btn_BrowseExcel" Grid.Row="0" Grid.Column="2" 
                                      Style="{StaticResource MaterialDesignFlatToggleButton}" 
                                      Height="28" Width="30" VerticalAlignment="Center" Click="Btn_BrowseExcel_Click">
                            <materialDesign:PackIcon Kind="Paperclip" Foreground="#0F2240" Width="18" Height="18"/>
                        </ToggleButton>

                        <!-- Row 1: CSI ETABS -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Model CSI ETABS :" VerticalAlignment="Center" 
                                   FontFamily="Segoe UI" Foreground="#0F2240" FontWeight="Bold" Margin="4,0,0,0"/>
                        <ComboBox x:Name="CB_CSI" Grid.Row="1" Grid.Column="1" Margin="4,0,4,0" 
                                  SelectionChanged="CB_CSI_SelectionChanged"/>
                        <ToggleButton x:Name="Btn_BrowseCSI" Grid.Row="1" Grid.Column="2" 
                                      Style="{StaticResource MaterialDesignFlatToggleButton}" 
                                      Height="28" Width="30" VerticalAlignment="Center" Click="Btn_BrowseCSI_Click">
                            <materialDesign:PackIcon Kind="Paperclip" Foreground="#0F2240" Width="18" Height="18"/>
                        </ToggleButton>

                        <!-- Row 2: AutoCAD -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bản vẽ AutoCAD :" VerticalAlignment="Center" 
                                   FontFamily="Segoe UI" Foreground="#0F2240" FontWeight="Bold" Margin="4,0,0,0"/>
                        <ComboBox x:Name="CB_AutoCAD" Grid.Row="2" Grid.Column="1" Margin="4,0,4,0" 
                                  SelectionChanged="CB_AutoCAD_SelectionChanged"/>
                        <ToggleButton x:Name="Btn_BrowseAutoCAD" Grid.Row="2" Grid.Column="2" 
                                      Style="{StaticResource MaterialDesignFlatToggleButton}" 
                                      Height="28" Width="30" VerticalAlignment="Center" Click="Btn_BrowseAutoCAD_Click">
                            <materialDesign:PackIcon Kind="Paperclip" Foreground="#0F2240" Width="18" Height="18"/>
                        </ToggleButton>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Bottom Actions Bar -->
            <Grid Grid.Row="2" Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblStatus" Grid.Column="0" Text="Sẵn sàng kết nối." 
                           VerticalAlignment="Center" Foreground="#107C41" FontFamily="Segoe UI" FontSize="11" FontStyle="Italic" FontWeight="Medium"/>

                <Button x:Name="Btn_Refresh" Grid.Column="1" Click="Btn_Refresh_Click" 
                        Margin="0,0,8,0" Height="30" Padding="12,0" Cursor="Hand"
                        Style="{StaticResource MaterialDesignOutlinedButton}" 
                        Foreground="#0F2240" BorderBrush="#0F2240">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F2240"/>
                        <TextBlock Text="Quét Lại" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#0F2240"/>
                    </StackPanel>
                </Button>

                <Button x:Name="Btn_Apply" Grid.Column="2" Click="Btn_Apply_Click" 
                        Height="30" Padding="14,0" Cursor="Hand"
                        Background="#0F2240" BorderBrush="#0F2240" Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonProgressAssist.Value="-1"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White"/>
                        <TextBlock Text="Kết nối API" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
