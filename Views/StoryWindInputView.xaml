<Window x:Class="QksExcelAddIn.Views.StoryWindInputView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QKS · Nhập tải gió theo Story" Width="1080" Height="600" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12" FontWeight="Normal" Background="#F8FAFC">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/Views/Styles/VisualWorkspaceStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button Content="Nhập file Excel / CSV" Click="ImportFile_Click"/><Button Content="Đọc vùng chọn Excel" Click="Selection_Click"/><Button Content="Xuất mẫu Excel" Click="Template_Click"/></WrapPanel>
        <TextBlock x:Name="Help" Grid.Row="1" Text="Nhập trực tiếp theo Story. Dầm: q1/q2 (kN/m); User Loads: Fx/Fy (kN), Mz (kN·m), X/Y (m). Ô trống không tự thành 0. Chưa ghi ETABS." TextWrapping="Wrap" Margin="2,8"/>
        <TabControl Grid.Row="2">
            <TabItem Header="Dầm biên · q1/q2"><DataGrid x:Name="BeamGrid" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True"/></TabItem>
            <TabItem Header="User Loads · lực theo tầng"><DataGrid x:Name="UserGrid" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True"/></TabItem>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button Content="Hủy" DockPanel.Dock="Right" Click="Cancel_Click"/><Button Content="Kiểm tra và đưa vào nháp" DockPanel.Dock="Right" Click="Accept_Click"/><TextBlock Text="Dầm để trống UniqueName: chỉ dùng các dầm đang chọn thuộc Story. User Loads: tự đối chiếu đúng tầng–khóa diaphragm đã có." TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,8,0"/></DockPanel>
    </Grid>
</Window>
