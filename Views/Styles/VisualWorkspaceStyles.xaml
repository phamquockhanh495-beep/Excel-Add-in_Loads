<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <!-- Use the same QKS Material Design resources as WallLoadView / ShellLoadView. -->
        <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/MaterialDesignResources.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Scoped to this viewer so the existing load windows keep their own formatting. -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#102A4C"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light" Color="#163D66"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark" Color="#08172B"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="White"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light.Foreground" Color="White"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark.Foreground" Color="White"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#102A4C"/>
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foreground" Color="White"/>

    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="#102A4C"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#163D66"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="3"/>
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        <Setter Property="materialDesign:RippleAssist.ClipToBounds" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#163D66"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#08172B"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="QksWorkspaceComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource QksWorkspaceComboBoxItem}"/>
    </Style>

    <Style x:Key="QksWorkspaceListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource QksWorkspaceListBoxItem}"/>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,6,14,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="QksWorkspaceTabItem" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}">
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource QksWorkspaceTabItem}"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#0F2240"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
</ResourceDictionary>
