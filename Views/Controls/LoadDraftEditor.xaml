<UserControl x:Class="QksExcelAddIn.Views.Controls.LoadDraftEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisible"/></UserControl.Resources>
    <StackPanel Margin="0,6,0,0">
        <TextBlock Text="{Binding EditorTarget}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4"/>
        <StackPanel IsEnabled="{Binding CanEditDraft}">
            <TextBlock Text="Load pattern"/>
            <ComboBox ItemsSource="{Binding AvailablePatterns}" SelectedItem="{Binding DraftPattern}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding DraftDirections}" SelectedItem="{Binding DraftDirection}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding DraftActions}" SelectedItem="{Binding DraftActionName}"/>
            </Grid>
            <StackPanel Visibility="{Binding WallInputsEnabled, Converter={StaticResource BoolVisible}}">
                <TextBlock Text="s1 / s2 (m từ đầu I của dầm)"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DraftStartMetres, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="2" Text="{Binding DraftEndMetres, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
            <TextBlock Text="{Binding DraftValueLabel}" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding DraftValue1, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1" Width="106" Margin="6,2,0,2" Visibility="{Binding WallInputsEnabled, Converter={StaticResource BoolVisible}}" Text="{Binding DraftValue2, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <Button Content="{Binding EditorCaption}" Click="Put_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Button Content="Dòng mới" Click="Reset_Click"/>
            <Button Content="Xóa dòng" IsEnabled="{Binding CanDeleteDraft}" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock Text="Thêm: cộng tải nháp. Thay: thay tất cả đoạn cùng đối tượng/pattern/hướng trong preview." TextWrapping="Wrap" Foreground="#64748B" Margin="0,4"/>
    </StackPanel>
</UserControl>
