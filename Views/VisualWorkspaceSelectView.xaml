<Window x:Class="QksExcelAddIn.Views.VisualWorkspaceSelectView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QKS · Select theo thuộc tính" Width="460" Height="580" MinWidth="360" MinHeight="360" WindowStartupLocation="CenterOwner" Background="#F8FAFC" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/Views/Styles/VisualWorkspaceStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel>
  <TextBlock Text="Loại cấu kiện"/><ComboBox x:Name="TypeBox" SelectionChanged="CriteriaChanged"/>
  <TextBlock Text="Chọn theo"/><ComboBox x:Name="AttributeBox" SelectionChanged="CriteriaChanged"/>
  <TextBlock Text="Phạm vi"/><ComboBox x:Name="ScopeBox" SelectionChanged="CriteriaChanged"/>
  <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Tìm nhanh trong danh sách giá trị"/>
  <TextBlock Text="Chọn nhiều giá trị bằng Ctrl / Shift. Khớp chính xác giá trị đã chọn." TextWrapping="Wrap" Foreground="#64748B" Margin="0,4"/>
 </StackPanel>
 <ListBox Grid.Row="1" x:Name="ValuesBox" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
 <StackPanel Grid.Row="2" Margin="0,8,0,0">
  <TextBlock x:Name="ResultText" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,6"/>
  <WrapPanel><Button Content="Chọn mới" Tag="Replace" Click="ApplySelection"/><Button Content="Thêm chọn" Tag="Add" Click="ApplySelection"/><Button Content="Bỏ chọn" Tag="Remove" Click="ApplySelection"/><Button Content="Đóng" Click="CloseClick"/></WrapPanel>
 </StackPanel></Grid>
</Window>
