<Window x:Class="QksExcelAddIn.Views.WindLoadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="QKS - Gán Tải Trọng Gió" Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FontSize="12"
        FontFamily="Segoe UI"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/MaterialDesignResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom GroupBox Style with Solid Navy Border and Underlined Header -->
            <Style x:Key="CustomGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="BorderBrush" Value="#0F2240"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Margin" Value="4,3,4,3"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- GroupBox Header (Underlined with Navy brush) -->
                                    <Border Grid.Row="0" Background="Transparent" Padding="8,4,8,4" BorderBrush="#0F2240" BorderThickness="0,0,0,0.5">
                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                    </Border>

                                    <!-- GroupBox Content -->
                                    <Border Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="#0F2240"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ComboBox Style -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="#0F2240" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Headbar (Navy #0F2240) -->
            <Grid Grid.Row="0" Background="#0F2240" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                    <Image Source="pack://application:,,,/QksExcelAddIn;component/Resources/windload.png" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QKS" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Margin="3,0,3,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="TÍNH TOÁN &amp; GÁN TẢI TRỌNG GIÓ VÀO ETABS" Foreground="White" 
                           FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="2,0,0,0"/>

                <!-- Minimize Button -->
                <Button Grid.Column="2" Content="—" Foreground="White" Background="Transparent" 
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                        Click="MinimizeButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#10B981"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="3" Content="✕" Foreground="White" Background="Transparent" 
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                        Click="CloseButton_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#DC3232"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Main Workspace -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel -->
                <Grid Grid.Column="0" Margin="0,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Connection Status -->
                    <GroupBox Header="TRẠNG THÁI KẾT NỐI (API)" Grid.Row="0" Style="{StaticResource CustomGroupBoxStyle}">
                        <StackPanel Margin="2,4">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotEtabs" Width="9" Height="9" Fill="#B71C1C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="lblEtabsStatus" Text="ETABS: Chưa kết nối" Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#B71C1C"/>
                            </Grid>
                            <TextBlock x:Name="lblModelName" Text="Chưa chọn mô hình (Kết Nối API từ Ribbon)" FontFamily="Segoe UI" FontSize="11" Margin="15,0,0,3" Foreground="#B71C1C" TextTrimming="CharacterEllipsis"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotCad" Width="9" Height="9" Fill="#B71C1C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="lblCadStatus" Text="AutoCAD: Chưa kết nối" Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#B71C1C"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Section Selection -->
                    <GroupBox Header="DANH SÁCH TIẾT DIỆN DẦM BIÊN" Grid.Row="1" Style="{StaticResource CustomGroupBoxStyle}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtSearchSection" Margin="0,0,0,4" 
                                     Style="{StaticResource MaterialDesignTextBox}" 
                                     materialDesign:HintAssist.Hint="Tìm kiếm tiết diện..."/>
                            <ScrollViewer Grid.Row="1">
                                <StackPanel x:Name="pnlSections">
                                    <CheckBox Content="B20X35" IsChecked="True" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="B25X35" IsChecked="True" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="B30X30" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="B30X60" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="B40X60" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="DMB" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="T10" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                    <CheckBox Content="T20" Style="{StaticResource MaterialDesignCheckBox}" Margin="2"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- Quick Actions -->
                    <GroupBox Header="THAO TÁC AUTOCAD" Grid.Row="2" Style="{StaticResource CustomGroupBoxStyle}">
                        <StackPanel Margin="2">
                            <Button Margin="0,2" Cursor="Hand"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Foreground="#0F2240" BorderBrush="#0F2240" Height="28" Padding="6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SelectAll" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F2240"/>
                                    <TextBlock Text="Lấy ID Cấu Kiện Chọn" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#0F2240"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="0,2" Cursor="Hand"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Foreground="#0F2240" BorderBrush="#0F2240" Height="28" Padding="6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F2240"/>
                                    <TextBlock Text="Kiểm Tra Mặt Bằng" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#0F2240"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- Right Main Panel -->
                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Controls -->
                    <Grid Grid.Row="0" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="BẢNG TÍNH TẢI GIÓ THEO TẦNG" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" 
                                       VerticalAlignment="Center" Foreground="#0F2240"/>
                            <TextBlock Text=" (Đọc dữ liệu hình học tầng &amp; dầm biên)" FontFamily="Segoe UI" FontSize="11.5" 
                                       Foreground="#666666" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Hướng Gió:" VerticalAlignment="Center" Margin="10,0,6,0" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#333333"/>
                            <ComboBox Width="95" SelectedIndex="0">
                                <ComboBoxItem Content="Phương X"/>
                                <ComboBoxItem Content="Phương Y"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WindRows}" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Style="{StaticResource MaterialDesignDataGrid}" 
                              RowStyle="{StaticResource QksDataGridRowStyle}"
                              CellStyle="{StaticResource QksDataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource QksDataGridColumnHeaderCenterStyle}"
                              FontFamily="Segoe UI" FontSize="11.5" BorderBrush="#0F2240" BorderThickness="0.5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Tầng" Binding="{Binding Name}" Width="85" IsReadOnly="True" ElementStyle="{StaticResource QksDataGridElementCenterStyle}"/>
                            <DataGridTextColumn Header="Chiều Cao (m)" Binding="{Binding Height}" Width="100" ElementStyle="{StaticResource QksDataGridElementCenterStyle}" EditingElementStyle="{StaticResource QksDataGridEditingStyle}"/>
                            <DataGridTextColumn Header="Cao Độ (m)" Binding="{Binding Elevation}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource QksDataGridElementCenterStyle}"/>
                            <DataGridTextColumn Header="Gió Đẩy X (kN/m)" Binding="{Binding WxPush}" Width="110" ElementStyle="{StaticResource QksDataGridElementCenterStyle}" EditingElementStyle="{StaticResource QksDataGridEditingStyle}"/>
                            <DataGridTextColumn Header="Gió Hút X (kN/m)" Binding="{Binding WxPull}" Width="110" ElementStyle="{StaticResource QksDataGridElementCenterStyle}" EditingElementStyle="{StaticResource QksDataGridEditingStyle}"/>
                            <DataGridTextColumn Header="Gió Hút Y (kN/m)" Binding="{Binding WyPull}" Width="110" ElementStyle="{StaticResource QksDataGridElementCenterStyle}" EditingElementStyle="{StaticResource QksDataGridEditingStyle}"/>
                            <DataGridTextColumn Header="Gió Đẩy Y (kN/m)" Binding="{Binding WyPush}" Width="110" ElementStyle="{StaticResource QksDataGridElementCenterStyle}" EditingElementStyle="{StaticResource QksDataGridEditingStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Controls -->
                    <Grid Grid.Row="2" Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="lblStatus" Text="Sẵn sàng gán tải trọng gió." VerticalAlignment="Center" Foreground="#107C41" FontFamily="Segoe UI" FontSize="11" FontStyle="Italic" FontWeight="Medium"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Foreground="#0F2240" BorderBrush="#0F2240" Height="32" Padding="12,0" Margin="0,0,8,0"
                                    Cursor="Hand" Click="OnDocTangEtabsClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LayersOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F2240"/>
                                    <TextBlock Text="ĐỌC TẦNG TỪ ETABS" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#0F2240"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Foreground="#0F2240" BorderBrush="#0F2240" Height="32" Padding="12,0" Margin="0,0,8,0"
                                    Cursor="Hand" Click="OnDocFileAutoCadClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileCad" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#0F2240"/>
                                    <TextBlock Text="ĐỌC TỪ AUTOCAD" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#0F2240"/>
                                </StackPanel>
                            </Button>
                            <Button Height="32" Padding="16,0" Cursor="Hand"
                                    Background="#0F2240" BorderBrush="#0F2240" Foreground="White"
                                    Style="{StaticResource MaterialDesignRaisedButton}" 
                                    materialDesign:ButtonProgressAssist.Value="-1"
                                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="True"
                                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                    Click="OnGanTaiGioClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WeatherWindy" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White"/>
                                    <TextBlock Text="GÁN TẢI GIÓ" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
