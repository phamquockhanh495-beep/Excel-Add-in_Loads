<Window x:Class="QksExcelAddIn.Views.WindLoadView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:QksExcelAddIn.Views.Controls"
 Title="QKS | TẢI GIÓ · DIAPHRAGMS / DẦM BIÊN" Width="1440" Height="900" MinWidth="980" MinHeight="620"
 WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI" FontSize="12" Foreground="#0F2240">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/VisualWorkspaceStyles.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="WindHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Kết nối API" Click="ConnectClick" IsEnabled="{Binding Viewer.CanRead}"/><Button Content="Đọc lại ETABS" Click="ReadClick" IsEnabled="{Binding Viewer.CanRead}"/><Button Content="Hủy tác vụ" Click="CancelClick" IsEnabled="{Binding Busy}"/></StackPanel>
   <TextBlock x:Name="ModelText" Text="Chưa đọc mô hình ETABS" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8"/>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,6">
    <Button Content="Nhập Excel / CSV" Click="ImportClick"/><Button Content="Lấy vùng Excel" Click="ExcelClick"/><Button Content="Xuất mẫu" Click="TemplateClick"/>
    <Button Content="Mở bộ gió" Click="OpenClick"/><Button Content="Xuất Excel bộ soạn" Click="ExportClick"/><Button Content="Thông tin API" Click="ProbeClick"/>
    <TextBlock Text="Giá trị đã tính · kN / m · không tự quy đổi áp lực" VerticalAlignment="Center" Margin="12,0" Foreground="#64748B"/>
   </WrapPanel>
   <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}" IsEnabled="{Binding CanEdit}">
    <TabItem Header="1. DIAPHRAGMS · USER LOADS">
     <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><Button DockPanel.Dock="Right" Content="Story / Load Sets…" Click="UserSettingsClick"/><Button DockPanel.Dock="Right" Content="Đọc User Loads" Click="ReadUsersClick"/><TextBlock Text="Load Pattern (Wind / User Loads)" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding UserPattern}" MinWidth="180" MaxWidth="420" HorizontalAlignment="Left"/></DockPanel>
      <Border Grid.Row="1" Background="#EFF5FB" Padding="10" Margin="0,8"><TextBlock TextWrapping="Wrap" Text="Sửa các khóa User Loads đã đọc từ ETABS. Story là thông tin đối chiếu: API hiện không trả Story/Load Set riêng. Dùng Story / Load Sets để mở bảng nâng cao khi schema host có đủ trường; nếu không, thiết lập các mục này trong ETABS."/></Border>
      <DataGrid x:Name="UserGrid" Grid.Row="2" ItemsSource="{Binding UserRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" PreviewKeyDown="UserGridKeyDown"/>
      <CheckBox Grid.Row="3" Margin="0,10" Content="Tôi đã đối chiếu từng khóa API với Story/Diaphragm trong ETABS; chỉ sửa giá trị các khóa hiện hữu." IsChecked="{Binding MappingConfirmed}"/>
      <DockPanel Grid.Row="4"><Button DockPanel.Dock="Right" Content="Hoàn nguyên giá trị đã đọc" Click="ResetUsersClick"/><Button DockPanel.Dock="Right" Content="Redo" Click="RedoUsersClick"/><Button DockPanel.Dock="Right" Content="Undo" Click="UndoUsersClick"/><TextBlock Text="{Binding UserSummary}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
     </Grid>
    </TabItem>
    <TabItem Header="2. DẦM BIÊN · MODEL 2D">
     <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="5"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
       <TextBlock Text="TẦNG VÀ HIỂN THỊ" Style="{StaticResource WindHeading}"/>
       <ComboBox ItemsSource="{Binding Viewer.Levels}" SelectedItem="{Binding Viewer.Level}"/>
       <TextBlock Text="Page Up / Down: chuyển tầng" FontSize="11" Foreground="#64748B" Margin="0,6"/>
       <Button Content="Select theo thuộc tính…" Click="SelectClick"/><Button Content="Vừa khung" Click="FitClick"/><Button Content="Bỏ chọn" Click="ClearSelectionClick"/>
       <Button Content="Chỉ hiện đối tượng chọn" Click="IsolateClick"/><Button Content="Hiện lại tất cả" Click="ShowAllClick"/>
       <CheckBox Content="Lưới trục" IsChecked="{Binding Viewer.ShowGrids}" Margin="0,8"/>
       <CheckBox Content="Extrude" IsChecked="{Binding Viewer.Extrude}" Margin="0,8"/>
       <Button Content="Text / màu chữ…" Click="TextClick"/><Button Content="Color Objects…" Click="ColorsClick"/>
       <Button Content="Chọn 2 điểm mặt cắt" Click="SectionClick"/><Button Content="Về mặt bằng" Click="PlanClick"/>
       <CheckBox Content="Elevation: cô lập tầng" IsChecked="{Binding Viewer.IsolateStory}" Margin="0,8"/>
       <CheckBox x:Name="ShowExisting" Content="Hiện tải đã đọc" IsChecked="False" Checked="LoadModeChanged" Unchecked="LoadModeChanged"/>
       <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,10"/>
       <TextBlock Text="Xem trước: nét tím đứt và mũi tên. Gán theo trục Global, giữ thứ tự I → J. Không tự chọn toàn bộ dầm trong tầng." TextWrapping="Wrap" Foreground="#64748B"/>
      </StackPanel></ScrollViewer>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
      <controls:StructuralCanvas x:Name="Canvas" Grid.Column="2" Items="{Binding Viewer.Scene}" SelectedIds="{Binding Viewer.SelectedIds}" GridItems="{Binding Viewer.GridScene}" Levels="{Binding Viewer.DisplayLevels}" Elevation="{Binding Viewer.Elevation}" ExtrudeEnabled="{Binding Viewer.Extrude}" LabelSettings="{Binding Viewer.LabelSettings}" ObjectColors="{Binding Viewer.ObjectColors}" StructureText="{Binding Viewer.StructureText}" LoadText="{Binding Viewer.LoadText}" DraftOverlays="{Binding BeamOverlays}" ShowDraftValues="False" ReadLoadItems="{Binding PreviewLoads}"/>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,0,0,0">
       <TextBlock Text="THIẾT LẬP TẢI ĐƯỜNG" Style="{StaticResource WindHeading}"/>
       <TextBlock Text="Load Pattern đích (Wind)"/><ComboBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding BeamPattern}"/>
       <TextBlock Text="Hướng tải" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"/>
       <TextBlock Text="q1 tại I / đầu đoạn (kN/m)" Margin="0,8,0,0"/><TextBox Text="{Binding Q1,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="q2 tại J / cuối đoạn (trống = q1)" Margin="0,8,0,0"/><TextBox Text="{Binding Q2,UpdateSourceTrigger=PropertyChanged}"/>
       <CheckBox Content="Đoạn theo tỷ lệ r (0 → 1)" IsChecked="{Binding Relative}" Margin="0,10"/>
       <TextBlock Text="Bắt đầu / Kết thúc (r; bỏ tick: m)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Start,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/><TextBox Grid.Column="1" Text="{Binding End,UpdateSourceTrigger=PropertyChanged}"/></Grid>
       <CheckBox Content="Cộng thêm vào tải hiện hữu" IsChecked="{Binding Append}" Margin="0,10"/>
       <TextBlock Text="Không tick: thay tải cùng hướng trong đoạn đã chọn; giữ phần tải ngoài đoạn." TextWrapping="Wrap" Foreground="#64748B"/>
       <Button Content="Đưa vào bộ gán / Cập nhật" Click="StageClick" Margin="0,12,0,4"/>
       <Button Content="PDF tải đã đọc từ ETABS…" Click="PdfClick"/>
       <TextBlock Text="{Binding BeamSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10"/>
      </StackPanel></ScrollViewer>
      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="5" HorizontalAlignment="Stretch"/>
      <DockPanel Grid.Row="2" Grid.ColumnSpan="5"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBlock Text="BỘ TẢI CHUẨN BỊ GÁN" FontWeight="SemiBold" Margin="0,6,14,6"/><Button Content="Xóa dòng chọn" Click="DeleteBeamClick"/><Button Content="Undo" Click="UndoClick"/><Button Content="Redo" Click="RedoClick"/></StackPanel>
       <DataGrid x:Name="BeamGrid" ItemsSource="{Binding BeamRows}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended" SelectionChanged="BeamSelected">
        <DataGrid.Columns><DataGridTextColumn Header="Unique ID" Binding="{Binding ElementId}" Width="*"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*"/><DataGridTextColumn Header="Hướng" Binding="{Binding DirectionName}" Width="*"/><DataGridTextColumn Header="r1" Binding="{Binding Start}"/><DataGridTextColumn Header="r2" Binding="{Binding End}"/><DataGridTextColumn Header="q1 (kN/m)" Binding="{Binding Value1}"/><DataGridTextColumn Header="q2 (kN/m)" Binding="{Binding Value2}"/><DataGridTextColumn Header="Action" Binding="{Binding Action}"/></DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Grid>
    </TabItem>
   </TabControl>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Lưu bộ gió" Click="SaveClick" IsEnabled="{Binding Viewer.CanRead}"/><Button Content="Kiểm tra / Xem trước" Click="ReviewClick" IsEnabled="{Binding CanEdit}"/><Button Content="Gán ETABS" Click="ApplyClick" IsEnabled="{Binding CanApply}"/><Button Content="Đóng" Click="CloseClick" IsEnabled="{Binding Viewer.CanRead}"/></StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,12,0"/></DockPanel>
 </Grid>
</Window>
