<Window x:Class="QksExcelAddIn.Views.VisualLoadWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewer="clr-namespace:QksExcelAddIn.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QKS · Quản lý tải trọng 2D · Chỉ đọc" Width="1180" Height="740" MinWidth="640" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" Background="#F8FAFC" Foreground="#0F2240"
        FontFamily="Segoe UI" FontSize="11.5" FontWeight="Normal" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/QksExcelAddIn;component/Resources/excel.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/Views/Styles/VisualWorkspaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#0F2240" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <!-- Same compact QKS titlebar as WallLoadView/ShellLoadView. Commands belong in the workspace. -->
        <Grid Background="#0F2240">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                <Image Source="pack://application:,,,/QksExcelAddIn;component/Resources/excel.png" Width="18" Height="18" Margin="0,0,6,0"/>
                <TextBlock Text="QKS" Foreground="#38BDF8" FontWeight="Bold"/>
                <TextBlock Text="  |  " Foreground="#64748B"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="QUẢN LÝ TẢI TRỌNG 2D · CHỈ ĐỌC" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource QksTitleBarButton}" ToolTip="Thu nhỏ" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource QksTitleBarButton}" ToolTip="Phóng to / Khôi phục" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource QksTitleBarCloseButton}" ToolTip="Đóng" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" Padding="10,3"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="File tính:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="ConnectedFileText" Grid.Column="1" Text="Chưa chọn file Excel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Mô hình kết nối:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ConnectedModelBox" Grid.Column="3" DisplayMemberPath="WorkspaceDisplay" DropDownOpened="ModelList_Opened" SelectionChanged="ModelList_Changed" ToolTip="Mở danh sách để quét ETABS đang chạy; chọn mô hình rồi Đọc lại."/>
            </Grid>
        </Grid></Border>
        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DisplayColumn" Width="200"/><ColumnDefinition x:Name="DisplayGap" Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorGap" Width="6"/><ColumnDefinition x:Name="EditorColumn" Width="285"/></Grid.ColumnDefinitions>
            <Border x:Name="DisplayPane" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="KẾT NỐI MÔ HÌNH" FontWeight="SemiBold"/>
                <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="Chọn API" Click="Connect_Click"/><Button Grid.Column="1" Content="Đọc lại" Click="Read_Click"/>
                </Grid>
                <Button Content="Hủy đọc" Click="Cancel_Click" IsEnabled="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}"/>
                <Separator Margin="0,6"/>
                <TextBlock Text="VÙNG HIỂN THỊ" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal"><RadioButton x:Name="PlanRadio" Content="Plan" IsChecked="True" Checked="Plan_Checked"/><RadioButton Content="Elevation" IsChecked="{Binding Elevation}"/></StackPanel>
                <TextBlock Text="Tầng / cao độ Plan" ToolTip="Page Up: lên tầng · Page Down: xuống tầng"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
                <TextBlock Text="PgUp: lên tầng · PgDn: xuống tầng" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,5"/>
                <CheckBox Content="Đảo hướng nhìn" IsChecked="{Binding Reverse}"/>
                <TextBlock Text="Nửa dải xem ±d (m)"/><TextBox Text="{Binding HalfDepth, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Cập nhật vùng xem" Click="Project_Click"/>
                <Button Content="Chọn 2 điểm / Hủy" Click="PickElevation_Click" ToolTip="Chọn hai điểm trên Plan để dựng Elevation; Esc để hủy."/>
                <StackPanel Visibility="{Binding Elevation, Converter={StaticResource BoolVisible}}" Margin="0,10,0,0">
                    <TextBlock Text="MẶT CẮT ĐÃ LƯU" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding SavedSections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Name"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Xem" Click="OpenSection_Click"/><Button Grid.Column="1" Content="Xóa" Click="DeleteSection_Click"/>
                    </Grid>
                    <TextBlock Text="Tên mặt cắt" Margin="0,5,0,0"/><TextBox Text="{Binding SectionName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    <Button Content="Lưu / cập nhật" Click="SaveSection_Click"/>
                    <TextBlock Text="Lưu riêng theo file ETABS trên máy này." Foreground="#64748B" TextWrapping="Wrap" FontSize="10.5"/>
                </StackPanel>
                <Separator Margin="0,6"/>
                <TextBlock Text="SAFE 18–22: đang phát triển adapter" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
            </StackPanel></ScrollViewer></Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                    <ToggleButton DockPanel.Dock="Right" x:Name="DisplaySettingsButton" Style="{StaticResource WorkspaceSettingsButton}" ToolTip="Thiết lập hiển thị cấu kiện">
                        <materialDesign:PackIcon Kind="CogOutline" Width="19" Height="19"/>
                    </ToggleButton>
                    <WrapPanel>
                    <Button Content="Display" Click="DisplayMenu_Click" ToolTip="Công cụ hiển thị · Text"/>
                    <Button Content="Thuộc tính" Click="ToggleEditor_Click" ToolTip="Ẩn / hiện thuộc tính cấu kiện"/>

                    <Popup PlacementTarget="{Binding ElementName=DisplaySettingsButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=DisplaySettingsButton}" StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource Panel}" Width="480" MaxHeight="490" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <Border Background="#0F2240" Padding="12" Margin="0,0,0,10"><TextBlock Text="QKS · THIẾT LẬP HIỂN THỊ 2D" Foreground="White" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="Lọc cấu kiện"/>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"/>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm ID, Label, Story, Property"/>
                            <CheckBox Content="Extrude · kích thước tiết diện thực (m)" IsChecked="{Binding Extrude}" Margin="0,8"/>
                            <Grid Background="#EEF3F8" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Cấu kiện" VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Hiện" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Extrude" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Label" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="UniqueName" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="Section" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Section / Property"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding LabelSettings}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Margin="4,0"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Visible}" Click="Style_Click" HorizontalAlignment="Center" ToolTip="Hiện cấu kiện"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Extrude}" Click="Style_Click" HorizontalAlignment="Center" ToolTip="Extrude loại cấu kiện này"/>
                                    <CheckBox Grid.Column="3" IsChecked="{Binding Label}" Click="Style_Click" HorizontalAlignment="Center" ToolTip="Label"/>
                                    <CheckBox Grid.Column="4" IsChecked="{Binding UniqueName}" Click="Style_Click" HorizontalAlignment="Center" ToolTip="UniqueName"/>
                                    <CheckBox Grid.Column="5" IsChecked="{Binding Section}" Click="Style_Click" HorizontalAlignment="Center" ToolTip="Section / Property"/>
                                </Grid></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <CheckBox Content="Màu theo Property (bỏ chọn: màu theo loại cấu kiện)" IsChecked="{Binding ColorByProperty}" Click="Style_Click" Margin="0,10,0,4"/>
                            <TextBlock Text="Màu theo loại: Display → Color Objects · Đối tượng đang chọn: đỏ đô" TextWrapping="Wrap" Foreground="#64748B"/>
                            <TextBlock Text="Dầm/sàn: cote mô hình là đỉnh, chiều dày xuống dưới. Cột/vách luôn có đường bao; Extrude bật/tắt tô màu. Tiết diện chưa hỗ trợ hoặc thiếu dữ liệu giữ đường trục/biên." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel></ScrollViewer></Border>
                    </Popup>
                    <Button Content="Select" Click="SelectAttributes_Click" IsEnabled="{Binding CanShowAll}" ToolTip="Chọn theo Section, UniqueName, Label"/>
                    <Button Content="Vừa khung" Click="Fit_Click"/>
                    </WrapPanel>
                </DockPanel>
                <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Background="White"><Grid><viewer:StructuralCanvas x:Name="Canvas" SlabRegions="{Binding SlabRegions}" StructureText="{Binding StructureText}" LoadText="{Binding LoadText}" Items="{Binding Scene}" ReadLoadItems="{Binding ReadLoadItems}" ShowLoadValues="{Binding ShowLoadValues}" ExtrudeEnabled="{Binding Extrude}" CutStart="{Binding CutStart}" CutEnd="{Binding CutEnd}" SelectedId="{Binding SelectedId}" SelectedIds="{Binding SelectedIds}" LabelSettings="{Binding LabelSettings}" Elevation="{Binding Elevation}" Levels="{Binding Levels}" HasOpenings="{Binding HasOpenings}" ColorByProperty="{Binding ColorByProperty}" ObjectColors="{Binding ObjectColors}" ColorOverrides="{Binding ColorOverrides}"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Background="#EEFFFFFF" Padding="8" MaxWidth="360" Visibility="{Binding HasSlabLegend, Converter={StaticResource BoolVisible}}">
                     <StackPanel><TextBlock Text="PHÂN LOẠI TẢI SÀN" FontWeight="SemiBold"/><ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SlabLegend}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Border Background="{Binding Color}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Top"/><ItemsControl ItemsSource="{Binding LegendLines}"><ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,2"><Run Text="{Binding PatternHeading, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding Value, Mode=OneWay}" Foreground="{Binding DataContext.SlabLegendValueColor, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/><Run Text="{Binding Axes, Mode=OneWay}" FontStyle="Italic"/><Run Text="{Binding LoadSet, Mode=OneWay}" FontWeight="Bold"/><Run Text="{Binding Source, Mode=OneWay}"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
                    </Border></Grid></Border>
            </Grid>
            <Border x:Name="EditorPane" Grid.Column="4" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border Background="#E8EFF7" CornerRadius="3" Padding="10,12" Margin="0,0,0,10">
                    <TextBlock Text="THUỘC TÍNH ĐỐI TƯỢNG" FontWeight="Bold" FontSize="12" Foreground="#102A4C" TextWrapping="Wrap"/>
                </Border>
                <Border Background="#F1F6FC" BorderBrush="#D3E0EF" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10"><StackPanel>
                    <TextBlock Text="{Binding InspectorTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#0072BC" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding InspectorSubtitle}" Foreground="#52657C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel></Border>
                <ItemsControl ItemsSource="{Binding InspectorRows}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="2,5"><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#102A4C" FontWeight="Normal" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Expander Header="TỌA ĐỘ ĐỐI TƯỢNG (m)" Visibility="{Binding SingleSelection, Converter={StaticResource BoolVisible}}" Margin="0,10,0,4">
                    <ItemsControl ItemsSource="{Binding InspectorCoordinates}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,5"><StackPanel>
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="#0072BC"/>
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Foreground="#102A4C" Margin="0,3,0,0"/>
                        </StackPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Expander>
                <Button Content="Bỏ chọn" Click="ClearSelection_Click" Margin="0,10,0,4"/>
                <Separator Margin="0,12,0,8"/>
                <Border Background="#E8EFF7" CornerRadius="3" Padding="10"><TextBlock Text="QUẢN LÝ TẢI TRỌNG" FontWeight="Bold" FontSize="12" Foreground="#102A4C"/></Border>
                <StackPanel Orientation="Horizontal"><RadioButton Content="Load Pattern" IsChecked="{Binding PatternMode}"/><RadioButton Content="Load Sets" IsChecked="{Binding LoadSetsMode}"/></StackPanel>
                <TextBlock Text="Load Pattern" Margin="0,10,0,2"/>
                <ComboBox IsEnabled="{Binding PatternMode}" ItemsSource="{Binding ReadPatterns}" SelectedItem="{Binding ReadPattern}"/>
                <TextBlock Text="Uniform Load Sets · Shell" Margin="0,6,0,0"/>
                <ComboBox IsEnabled="{Binding LoadSetsMode}" ItemsSource="{Binding UniformLoadSets}" SelectedItem="{Binding UniformLoadSet}"/>
                <TextBlock Text="{Binding UniformSetNote}" TextWrapping="Wrap" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,5"/>
                <WrapPanel Margin="0,4" IsEnabled="{Binding PatternMode}"><CheckBox Content="Frame" IsChecked="{Binding ShowFrameLoads}" Foreground="DarkCyan" Margin="0,3,10,3"/><CheckBox Content="Shell" IsChecked="{Binding ShowShellLoads}" Foreground="RoyalBlue" Margin="0,3,10,3"/><CheckBox Content="Joint" IsChecked="{Binding ShowJointLoads}" Foreground="DarkViolet" Margin="0,3"/></WrapPanel>
                <CheckBox Content="Hiện nhãn tải (sàn: tên Pattern / Set)" IsChecked="{Binding ShowLoadValues}"/>
                <CheckBox Content="Chỉ đối tượng đang chọn" IsChecked="{Binding OnlySelectedLoads}"/>
                <CheckBox IsEnabled="{Binding PatternMode}" Content="Kể cả thành phần bằng 0" IsChecked="{Binding ShowZeroLoads}"/>
                <Expander Header="XUẤT TẢI SÀN · .XLSX" Margin="0,6" IsEnabled="{Binding CanRead}"><StackPanel>
                    <TextBlock Text="Theo chế độ và Pattern / Set đang chọn. Gồm cả tải bằng 0; không lọc theo chọn/ẩn cấu kiện." TextWrapping="Wrap" FontSize="10.5" Foreground="#64748B" Margin="0,4"/>
                    <Button Content="Xuất tầng đang xem" Click="ExportSlabCurrent_Click" ToolTip="Trong Plan: xuất toàn bộ sàn thuộc tầng đang chọn"/>
                    <Button Content="Xuất toàn bộ tầng" Click="ExportSlabAll_Click" Margin="0,4,0,0"/>
                </StackPanel></Expander>
                <TextBlock Text="{Binding ReadSourceSummary}" TextWrapping="Wrap" Foreground="#64748B" FontSize="10.5" Margin="0,5"/>
                <TextBlock Text="{Binding ReadLoadSummary}" Foreground="#0072BC" TextWrapping="Wrap" Margin="0,8"/>
                <ListBox ItemsSource="{Binding ReadLoadItems}" SelectionChanged="ReadLoad_SelectionChanged" ToolTip="Chọn dòng tải để chọn cấu kiện trên hình" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#102A4C" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#52657C" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Plan: nét đỏ đô thể hiện chiều dài đoạn tải phân bố đứng trên dầm. Các tải khác dùng mũi tên theo hướng; kích thước tự chuẩn hóa riêng theo nhóm/đơn vị (6–160 px). ⊗ vào / ⊙ ra mặt phẳng; mũi tên kép hoặc cung tròn: mômen. Pattern và step hiển thị riêng." TextWrapping="Wrap" Foreground="#64748B" FontSize="10.5" Margin="0,8"/>
                <Expander Header="PHẠM VI DỮ LIỆU ĐÃ ĐỌC" Margin="0,5"><StackPanel>
                    <TextBlock Text="{Binding LoadReadNote}" TextWrapping="Wrap" Foreground="#64748B"/>
                    <TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" FontSize="10.5"/>
                </StackPanel></Expander>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Border Grid.Row="3" Background="#0F2240" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#7DD3FC" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspector}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="White" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
        </Grid></Border>
    </Grid>
    </Border>
</Window>
