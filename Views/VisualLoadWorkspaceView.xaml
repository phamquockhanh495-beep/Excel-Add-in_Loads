<Window x:Class="QksExcelAddIn.Views.VisualLoadWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:QksExcelAddIn.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QKS · Không gian tải trọng 2D · Preview 5" Width="1180" Height="740" MinWidth="640" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" Background="#F8FAFC" Foreground="#0F2240"
        FontFamily="Segoe UI" FontSize="11.5" FontWeight="Normal" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/QksExcelAddIn;component/Resources/excel.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/Views/Styles/VisualWorkspaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#0F2240" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <!-- Same compact QKS titlebar as WallLoadView/ShellLoadView. Commands belong in the workspace. -->
        <Grid Background="#0F2240">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                <Image Source="pack://application:,,,/QksExcelAddIn;component/Resources/excel.png" Width="18" Height="18" Margin="0,0,6,0"/>
                <TextBlock Text="QKS" Foreground="#38BDF8" FontWeight="Bold"/>
                <TextBlock Text="  |  " Foreground="#64748B"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="KHÔNG GIAN TẢI TRỌNG 2D · PREVIEW 5" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource QksTitleBarButton}" ToolTip="Thu nhỏ" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource QksTitleBarButton}" ToolTip="Phóng to / Khôi phục" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource QksTitleBarCloseButton}" ToolTip="Đóng" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" Padding="10,3"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="File tính:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="ConnectedFileText" Grid.Column="1" Text="Chưa chọn file Excel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Mô hình kết nối:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ConnectedModelBox" Grid.Column="3" DisplayMemberPath="WorkspaceDisplay" DropDownOpened="ModelList_Opened" SelectionChanged="ModelList_Changed" ToolTip="Mở danh sách để quét ETABS đang chạy; chọn mô hình rồi Đọc lại."/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding SourceText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}"/>
        </Grid></Border>
        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DisplayColumn" Width="200"/><ColumnDefinition x:Name="DisplayGap" Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorGap" Width="6"/><ColumnDefinition x:Name="EditorColumn" Width="285"/></Grid.ColumnDefinitions>
            <Border x:Name="DisplayPane" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="KẾT NỐI MÔ HÌNH" FontWeight="SemiBold"/>
                <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="Chọn API" Click="Connect_Click"/><Button Grid.Column="1" Content="Đọc lại" Click="Read_Click"/>
                </Grid>
                <Button Content="Hủy đọc" Click="Cancel_Click" IsEnabled="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}"/>
                <Separator Margin="0,6"/>
                <TextBlock Text="VÙNG HIỂN THỊ" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal"><RadioButton x:Name="PlanRadio" Content="Plan" IsChecked="True" Checked="Plan_Checked"/><RadioButton Content="Elevation" IsChecked="{Binding Elevation}"/></StackPanel>
                <TextBlock Text="Tầng / cao độ Plan"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
                <CheckBox Content="Đảo hướng nhìn" IsChecked="{Binding Reverse}"/>
                <TextBlock Text="Nửa dải xem ±d (m)"/><TextBox Text="{Binding HalfDepth, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Cập nhật vùng xem" Click="Project_Click"/>
                <Button Content="Chọn 2 điểm / Hủy" Click="PickElevation_Click" ToolTip="Chọn hai điểm trên Plan để dựng Elevation; Esc để hủy."/>
                <Separator Margin="0,6"/>
                <TextBlock Text="LỚP &amp; HIỂN THỊ" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm ID, label, story hoặc property"/>
                <CheckBox Content="Label cấu kiện" IsChecked="{Binding ShowLabels}" Click="Style_Click" ToolTip="Hiện nhãn cấu kiện trong vùng nhìn; dầm xoay chữ theo hướng trục, giữ cỡ chữ khi zoom."/>
                <CheckBox Content="Section / Property" IsChecked="{Binding ShowSections}" Click="Style_Click"/>
                <CheckBox Content="UniqueName" IsChecked="{Binding ShowUniqueNames}" Click="Style_Click"/>
                <CheckBox Content="Giá trị tải nháp" IsChecked="{Binding ShowDraftValues}" Click="Style_Click" ToolTip="Hiện giá trị tải nháp trong vùng nhìn, giữ cỡ chữ khi zoom."/>
                <CheckBox Content="Màu theo property" IsChecked="{Binding ColorByProperty}" Click="Style_Click"/>
                <TextBlock Text="Dầm: xanh · Sàn: teal · Vách: tím · Chọn: cam" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
                <Expander Header="File snapshot" Margin="0,6"><StackPanel IsEnabled="{Binding CanRead}">
                    <Button Content="Mở snapshot" Click="Open_Click"/><Button Content="Lưu snapshot" Click="Save_Click"/>
                </StackPanel></Expander>
                <TextBlock Text="SAFE 18–22: đang phát triển adapter" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
            </StackPanel></ScrollViewer></Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition x:Name="TableRow" Height="225" MinHeight="115"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,4">
                    <Button Content="Hiển thị" Click="ToggleDisplay_Click" ToolTip="Ẩn / hiện panel hiển thị"/>
                    <Button Content="Tải / thuộc tính" Click="ToggleEditor_Click" ToolTip="Ẩn / hiện panel tải và thuộc tính"/>
                    <Button Content="Vừa khung" Click="Fit_Click"/>
                    <Button Content="Delete" Click="RemoveSelection_Click" IsEnabled="{Binding CanRemoveFromWorkspace}" ToolTip="Bỏ cấu kiện đang chọn khỏi workspace 2D. Không xóa trong ETABS và không xóa tải/nháp."/>
                    <Button Content="Khôi phục" Click="RestoreWorkspace_Click" IsEnabled="{Binding CanRestoreWorkspace}" ToolTip="Hiện lại toàn bộ cấu kiện đã bỏ khỏi workspace."/>
                    <TextBlock Text="{Binding Counts}" Margin="6,7,0,3" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Counts}"/>
                </WrapPanel>
                <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Background="White"><viewer:StructuralCanvas x:Name="Canvas" Items="{Binding Scene}" SelectedId="{Binding SelectedId}" SelectedIds="{Binding SelectedIds}" ShowLabels="{Binding ShowLabels}" ShowSections="{Binding ShowSections}" ShowUniqueNames="{Binding ShowUniqueNames}" Elevation="{Binding Elevation}" Levels="{Binding Levels}" HasOpenings="{Binding HasOpenings}" ColorByProperty="{Binding ColorByProperty}" ColorOverrides="{Binding ColorOverrides}" DraftOverlays="{Binding DraftOverlays}" ShowDraftValues="{Binding ShowDraftValues}"/></Border>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
                <TabControl x:Name="WorkspaceTabs" Grid.Row="3">
                    <TabItem Header="Đối tượng nguồn"><DataGrid x:Name="ObjectsTable" ItemsSource="{Binding VisibleElements}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Objects_SelectionChanged"><DataGrid.Columns>
                        <DataGridTextColumn Header="Unique ID" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource WorkspaceCellText}" HeaderStyle="{StaticResource WorkspaceHeaderLeft}"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="70" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Story" Binding="{Binding Story}" Width="85" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="65" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Length (m)" Binding="{Binding Length3D, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                    </DataGrid.Columns></DataGrid></TabItem>
                    <TabItem x:Name="DraftTab" Header="Nháp / So sánh"><TabControl>
                        <TabItem Header="Dòng nháp"><DataGrid x:Name="DraftTable" ItemsSource="{Binding DraftRows}" SelectionMode="Single" SelectionChanged="Draft_SelectionChanged"><DataGrid.Columns>
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding ElementId}"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}"/><DataGridTextColumn Header="Loại" Binding="{Binding KindName}"/><DataGridTextColumn Header="Thao tác" Binding="{Binding ActionName}"/><DataGridTextColumn Header="Hướng" Binding="{Binding DirectionName}"/><DataGridTextColumn Header="r1" Binding="{Binding Start, StringFormat=0.###}"/><DataGridTextColumn Header="r2" Binding="{Binding End, StringFormat=0.###}"/><DataGridTextColumn Header="V1" Binding="{Binding Value1, StringFormat=0.###}"/><DataGridTextColumn Header="V2" Binding="{Binding Value2, StringFormat=0.###}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}"/>
                        </DataGrid.Columns></DataGrid></TabItem>
                        <TabItem Header="Trước / Sau"><DataGrid ItemsSource="{Binding ComparisonRows}"><DataGrid.Columns>
                            <DataGridTextColumn Header="Mốc" Binding="{Binding Phase}"/><DataGridTextColumn Header="Nguồn" Binding="{Binding Origin}"/><DataGridTextColumn Header="Đối tượng" Binding="{Binding Load.ElementId}"/><DataGridTextColumn Header="Pattern" Binding="{Binding Load.Pattern}"/><DataGridTextColumn Header="Loại" Binding="{Binding Load.Kind}"/><DataGridTextColumn Header="CSys" Binding="{Binding Load.CoordinateSystem}"/><DataGridTextColumn Header="Dir API" Binding="{Binding Load.Direction}"/><DataGridTextColumn Header="r1" Binding="{Binding Load.Start, StringFormat=0.###}"/><DataGridTextColumn Header="r2" Binding="{Binding Load.End, StringFormat=0.###}"/><DataGridTextColumn Header="V1" Binding="{Binding Load.Value1, StringFormat=0.###}"/><DataGridTextColumn Header="V2" Binding="{Binding Load.Value2, StringFormat=0.###}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Load.Unit}"/>
                        </DataGrid.Columns></DataGrid></TabItem>
                    </TabControl></TabItem>
                    <TabItem Header="Tải đã đọc"><DataGrid ItemsSource="{Binding VisibleLoads}"><DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}"/><DataGridTextColumn Header="Loại" Binding="{Binding Kind}"/><DataGridTextColumn Header="CSys" Binding="{Binding CoordinateSystem}"/><DataGridTextColumn Header="Dir API" Binding="{Binding Direction}"/><DataGridTextColumn Header="r1" Binding="{Binding Start, StringFormat=0.###}"/><DataGridTextColumn Header="r2" Binding="{Binding End, StringFormat=0.###}"/><DataGridTextColumn Header="V1" Binding="{Binding Value1, StringFormat=0.###}"/><DataGridTextColumn Header="V2" Binding="{Binding Value2, StringFormat=0.###}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}"/>
                    </DataGrid.Columns></DataGrid></TabItem>
                    <TabItem x:Name="UserWindTab" Header="User Loads gió"><DataGrid x:Name="WindUserTable" ItemsSource="{Binding WindUserRows}" SelectedItem="{Binding SelectedWindUserRow}" IsReadOnly="False" IsEnabled="{Binding CanRead}" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns>
                        <DataGridTextColumn Header="Story (đối chiếu)" Binding="{Binding Story}" IsReadOnly="True"/><DataGridTextColumn Header="Khóa diaphragm (API)" Binding="{Binding DiaphragmKey}" IsReadOnly="True" Width="170"/>
                        <DataGridTextColumn Header="Fx (kN)" Binding="{Binding Fx, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="Fy (kN)" Binding="{Binding Fy, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="Mz (kN·m)" Binding="{Binding Mz, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="X (m)" Binding="{Binding X, ValidatesOnExceptions=True}"/>
                        <DataGridTextColumn Header="Y (m)" Binding="{Binding Y, ValidatesOnExceptions=True}"/>
                    </DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Chẩn đoán"><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></TabItem>
                </TabControl>
            </Grid>
            <Border x:Name="EditorPane" Grid.Column="4" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Expander Header="THUỘC TÍNH ĐỐI TƯỢNG">
                    <TextBox Text="{Binding Inspector, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
                </Expander>
                <Button Content="Bỏ chọn / xem tất cả tải" Click="ClearSelection_Click"/>
                <Separator Margin="0,6"/>
                <TextBlock Text="NHÁP TẢI TRỌNG" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding DraftStatus}" TextWrapping="Wrap" Margin="0,4" Foreground="#64748B"/>
                <WrapPanel IsEnabled="{Binding CanRead}"><Button Content="Lưu nháp" Click="SaveDraft_Click"/><Button Content="Mở nháp" Click="OpenDraft_Click"/><Button Content="Bộ mới" Click="NewDraft_Click"/></WrapPanel>
                <TabControl Margin="0,6" SelectedIndex="{Binding DraftModuleIndex}">
                    <TabItem Header="Dầm/Tường"><viewer:LoadDraftEditor DraftCommitted="DraftCommitted"/></TabItem>
                    <TabItem Header="Sàn"><viewer:LoadDraftEditor DraftCommitted="DraftCommitted"/></TabItem>
                    <TabItem Header="Gió"><StackPanel Margin="0,8">
                        <TextBlock Text="TẢI GIÓ THEO STORY" FontWeight="SemiBold"/>
                        <TextBlock Text="Lấy giá trị từ Excel hoặc nhập theo tầng. Dầm: q1/q2 (kN/m); User Loads: Fx/Fy/Mz/X/Y. Không quy đổi áp lực." TextWrapping="Wrap" Margin="0,6"/>
                        <StackPanel IsEnabled="{Binding CanRead}">
                            <TextBlock Text="Load pattern"/><ComboBox ItemsSource="{Binding AvailablePatterns}" SelectedItem="{Binding DraftPattern}"/>
                            <Button Content="Nhập từ file Excel / CSV" Click="WindExcel_Click" IsEnabled="{Binding CanInputStoryWind}"/>
                            <Button Content="Nhập giá trị theo Story…" Click="WindInput_Click" IsEnabled="{Binding CanInputStoryWind}"/>
                            <TextBlock Text="Trong popup có mẫu Excel, đọc vùng chọn và kiểm tra từng dòng trước khi đưa vào nháp. UniqueName trống chỉ dùng các dầm đang chọn thuộc Story." TextWrapping="Wrap" Foreground="#64748B" Margin="0,6"/>
                            <Separator Margin="0,6"/>
                            <TextBlock Text="USER LOADS / DIAPHRAGM" FontWeight="SemiBold"/>
                            <Button Content="Đọc User Loads của pattern" Click="ReadUserWind_Click"/>
                            <TextBlock Text="{Binding WindUserStatus}" TextWrapping="Wrap" Foreground="#64748B"/>
                            <TextBlock Text="Đọc khóa API trước khi nhập lực tầng; tự đối chiếu Story–diaphragm. Không tự tạo khóa hoặc lấy tâm cứng." TextWrapping="Wrap" Margin="0,6"/>
                            <WrapPanel><Button Content="Lưu gió" Click="SaveUserWind_Click"/><Button Content="Mở gió" Click="OpenUserWind_Click"/></WrapPanel>
                            <Button Content="Kiểm tra và Apply User Loads" Click="ApplyUserWind_Click" IsEnabled="{Binding CanApplyUserWind}"/>
                        </StackPanel>
                        <Button Content="Xóa dòng nháp đang chọn" Click="DeleteWindDraft_Click" IsEnabled="{Binding CanDeleteDraft}"/>
                    </StackPanel></TabItem>
                </TabControl>
                <WrapPanel><Button Content="Undo" IsEnabled="{Binding CanUndoDraft}" Click="UndoDraft_Click"/><Button Content="Redo" IsEnabled="{Binding CanRedoDraft}" Click="RedoDraft_Click"/></WrapPanel>
                <TextBlock Text="Tím: NHÁP. Trước/Sau gồm tải đã đọc. Apply chỉ mở với nguồn ETABS trực tiếp." TextWrapping="Wrap" Foreground="#9A3412" Margin="0,5"/>
                <Button Content="Kiểm tra và Apply ETABS" Click="Apply_Click" IsEnabled="{Binding CanApply}"/>
                <TextBlock Text="{Binding ApplySummary}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
                <Button Content="Lưu báo cáo Apply" Click="SaveApplyReport_Click" IsEnabled="{Binding CanRead}"/>
                <TextBlock Text="Lăn chuột: zoom · Chuột giữa/phải: pan · Quét trái/phải: chọn trọn/giao · Ctrl + click: thêm/bỏ · Delete: bỏ khỏi workspace · Khôi phục: hiện lại · Alt + click: đổi đối tượng chồng nhau" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Border Grid.Row="3" Background="#0F2240" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#7DD3FC" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspector}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="White" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
        </Grid></Border>
    </Grid>
    </Border>
</Window>
