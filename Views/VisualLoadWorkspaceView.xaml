<Window x:Class="QksExcelAddIn.Views.VisualLoadWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:QksExcelAddIn.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QKS · Quản lý tải trọng 2D · Chỉ đọc" Width="1180" Height="740" MinWidth="640" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" Background="#F8FAFC" Foreground="#0F2240"
        FontFamily="Segoe UI" FontSize="11.5" FontWeight="Normal" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/QksExcelAddIn;component/Resources/excel.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/QksExcelAddIn;component/Views/Styles/VisualWorkspaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#0F2240" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <!-- Same compact QKS titlebar as WallLoadView/ShellLoadView. Commands belong in the workspace. -->
        <Grid Background="#0F2240">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                <Image Source="pack://application:,,,/QksExcelAddIn;component/Resources/excel.png" Width="18" Height="18" Margin="0,0,6,0"/>
                <TextBlock Text="QKS" Foreground="#38BDF8" FontWeight="Bold"/>
                <TextBlock Text="  |  " Foreground="#64748B"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="QUẢN LÝ TẢI TRỌNG 2D · CHỈ ĐỌC" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource QksTitleBarButton}" ToolTip="Thu nhỏ" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource QksTitleBarButton}" ToolTip="Phóng to / Khôi phục" Click="Maximize_Click"/>
                <Button Content="✕" Style="{StaticResource QksTitleBarCloseButton}" ToolTip="Đóng" Click="Close_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="White" Padding="10,3"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="File tính:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="ConnectedFileText" Grid.Column="1" Text="Chưa chọn file Excel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Mô hình kết nối:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ConnectedModelBox" Grid.Column="3" DisplayMemberPath="WorkspaceDisplay" DropDownOpened="ModelList_Opened" SelectionChanged="ModelList_Changed" ToolTip="Mở danh sách để quét ETABS đang chạy; chọn mô hình rồi Đọc lại."/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding SourceText}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}"/>
        </Grid></Border>
        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DisplayColumn" Width="200"/><ColumnDefinition x:Name="DisplayGap" Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EditorGap" Width="6"/><ColumnDefinition x:Name="EditorColumn" Width="285"/></Grid.ColumnDefinitions>
            <Border x:Name="DisplayPane" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <TextBlock Text="KẾT NỐI MÔ HÌNH" FontWeight="SemiBold"/>
                <Grid IsEnabled="{Binding CanRead}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="Chọn API" Click="Connect_Click"/><Button Grid.Column="1" Content="Đọc lại" Click="Read_Click"/>
                </Grid>
                <Button Content="Hủy đọc" Click="Cancel_Click" IsEnabled="{Binding Busy}" Visibility="{Binding Busy, Converter={StaticResource BoolVisible}}"/>
                <Separator Margin="0,6"/>
                <TextBlock Text="VÙNG HIỂN THỊ" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal"><RadioButton x:Name="PlanRadio" Content="Plan" IsChecked="True" Checked="Plan_Checked"/><RadioButton Content="Elevation" IsChecked="{Binding Elevation}"/></StackPanel>
                <TextBlock Text="Tầng / cao độ Plan"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
                <CheckBox Content="Đảo hướng nhìn" IsChecked="{Binding Reverse}"/>
                <TextBlock Text="Nửa dải xem ±d (m)"/><TextBox Text="{Binding HalfDepth, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Cập nhật vùng xem" Click="Project_Click"/>
                <Button Content="Chọn 2 điểm / Hủy" Click="PickElevation_Click" ToolTip="Chọn hai điểm trên Plan để dựng Elevation; Esc để hủy."/>
                <Separator Margin="0,6"/>
                <TextBlock Text="SAFE 18–22: đang phát triển adapter" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
            </StackPanel></ScrollViewer></Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition x:Name="TableRow" Height="225" MinHeight="115"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,4">
                    <Button Content="Hiển thị" Click="ToggleDisplay_Click" ToolTip="Ẩn / hiện panel hiển thị"/>
                    <Button Content="Thuộc tính" Click="ToggleEditor_Click" ToolTip="Ẩn / hiện panel tải và thuộc tính"/>
                    <ToggleButton x:Name="DisplaySettingsButton" Content="⚙" ToolTip="Lớp và hiển thị" Width="38" Height="30" Margin="2"/>
                    <Popup PlacementTarget="{Binding ElementName=DisplaySettingsButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=DisplaySettingsButton}" StaysOpen="False" AllowsTransparency="True"><Border Style="{StaticResource Panel}" Width="235"><StackPanel>
                <TextBlock Text="LỚP &amp; HIỂN THỊ" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"/>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm ID, label, story hoặc property"/>
                <TextBlock Text="NHÃN THEO CẤU KIỆN" FontWeight="SemiBold" Margin="0,8,0,3"/>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LabelSettings}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="0,3"><TextBlock Text="{Binding Caption}" FontWeight="SemiBold"/><WrapPanel>
                        <CheckBox Content="Label" IsChecked="{Binding Label}" Click="Style_Click" Margin="0,2,8,2"/>
                        <CheckBox Content="UniqueName" IsChecked="{Binding UniqueName}" Click="Style_Click" Margin="0,2,8,2"/>
                        <CheckBox Content="Section / Property" IsChecked="{Binding Section}" Click="Style_Click" Margin="0,2"/>
                    </WrapPanel></StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <CheckBox Content="Màu theo property" IsChecked="{Binding ColorByProperty}" Click="Style_Click"/>
                <TextBlock Text="Dầm: xanh · Sàn: teal · Vách: tím · Chọn: cam" TextWrapping="Wrap" Foreground="#64748B" Margin="0,5"/>
                    </StackPanel></Border></Popup>
                    <Button Content="Vừa khung" Click="Fit_Click"/>
                    <Button Content="Delete" Click="RemoveSelection_Click" IsEnabled="{Binding CanRemoveFromWorkspace}" ToolTip="Bỏ cấu kiện đang chọn khỏi workspace 2D. Không xóa trong ETABS."/>
                    <Button Content="Khôi phục" Click="RestoreWorkspace_Click" IsEnabled="{Binding CanRestoreWorkspace}" ToolTip="Hiện lại toàn bộ cấu kiện đã bỏ khỏi workspace."/>
                    <TextBlock Text="{Binding Counts}" Margin="6,7,0,3" MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip="{Binding Counts}"/>
                </WrapPanel>
                <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" Background="White"><viewer:StructuralCanvas x:Name="Canvas" Items="{Binding Scene}" SelectedId="{Binding SelectedId}" SelectedIds="{Binding SelectedIds}" LabelSettings="{Binding LabelSettings}" Elevation="{Binding Elevation}" Levels="{Binding Levels}" HasOpenings="{Binding HasOpenings}" ColorByProperty="{Binding ColorByProperty}" ColorOverrides="{Binding ColorOverrides}"/></Border>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
                <TabControl x:Name="WorkspaceTabs" Grid.Row="3">
                    <TabItem Header="Đối tượng nguồn"><DataGrid x:Name="ObjectsTable" ItemsSource="{Binding VisibleElements}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Objects_SelectionChanged"><DataGrid.Columns>
                        <DataGridTextColumn Header="Unique ID" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource WorkspaceCellText}" HeaderStyle="{StaticResource WorkspaceHeaderLeft}"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="70" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Story" Binding="{Binding Story}" Width="85" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="65" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="*" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                        <DataGridTextColumn Header="Length (m)" Binding="{Binding Length3D, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                    </DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Tải đã đọc"><DataGrid ItemsSource="{Binding VisibleLoads}" ColumnWidth="*" MinColumnWidth="75"><DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="Loại" Binding="{Binding Kind}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="CSys" Binding="{Binding CoordinateSystem}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="Dir API" Binding="{Binding Direction}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="r1" Binding="{Binding Start, StringFormat=0.###}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="r2" Binding="{Binding End, StringFormat=0.###}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="V1" Binding="{Binding Value1, StringFormat=0.###}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="V2" Binding="{Binding Value2, StringFormat=0.###}" ElementStyle="{StaticResource WorkspaceCellCenter}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" ElementStyle="{StaticResource WorkspaceCellCenter}"/>
                    </DataGrid.Columns></DataGrid></TabItem>
                    <TabItem Header="Chẩn đoán"><TextBox Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></TabItem>
                </TabControl>
            </Grid>
            <Border x:Name="EditorPane" Grid.Column="4" Style="{StaticResource Panel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Expander Header="THUỘC TÍNH ĐỐI TƯỢNG">
                    <TextBox Text="{Binding Inspector, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
                </Expander>
                <Button Content="Bỏ chọn / xem tất cả tải" Click="ClearSelection_Click"/>
                <TextBlock Text="Lăn chuột: zoom · Chuột giữa/phải: pan · Quét trái/phải: chọn trọn/giao · Ctrl + click: thêm/bỏ · Esc: bỏ chọn / hủy thao tác · Delete: bỏ khỏi workspace · Khôi phục: hiện lại · Alt + click: đổi đối tượng chồng nhau" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Border Grid.Row="3" Background="#0F2240" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#7DD3FC" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Inspector}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="White" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
        </Grid></Border>
    </Grid>
    </Border>
</Window>
